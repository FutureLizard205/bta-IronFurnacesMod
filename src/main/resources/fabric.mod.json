{
  "schemaVersion": 1,
  "id": "ironfurnaces",
  "version": "${version}",

  "name": "Iron Furnaces",
  "description": "A simple mod that adds higher tiered furnaces.",
  "authors": [
    "FutureLizard205"
  ],
  "contact": {
    "homepage": "https://github.com/FutureLizard205/",
    "sources": "https://github.com/FutureLizard205/bta-IronFurnacesMod",
		"issues": "https://github.com/FutureLizard205/bta-IronFurnacesMod/issues"
  },

  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
    "main": [
      "fl205.ironfurnaces.IronFurnaces"
    ],
		"client": [
			"fl205.ironfurnaces.IronFurnacesClient"
		],
		"btwaila": [
			"fl205.ironfurnaces.modded.BTWaila.WailaPlugin"
		]
  },
	"mixins": [
		"ironfurnaces.mixins.json"
	],

  "depends": {
		"fabricloader": ">=${fabricloader}",
		"minecraft": "*",
		"java": ">=${java}",
		"halplibe": ">=6.1.0"
  },
	"suggests": {
		"btwaila": ">=1.3.0-8.0-pre1"
	},
  "icon": "icon.png"
}
